initial
    begin
    logic [31:0] x, expected;
    integer fd, status, errors;

    errors = 0;
    SW = 16'h0000;
    RESET_ALL();
    WAIT(100);

    udm.cfg(`DIVIDER_115200, 2'b00);
    udm.check();
    udm.hreset();

    fd = $fopen("vectors.txt", "r");
    if (fd == 0) begin
        $display("ERROR: cannot open vectors.txt");
        $stop;
    end

    while (!$feof(fd)) begin
        status = $fscanf(fd, "%h %h\n", x, expected);
        if (status == 2) begin
            udm.wr32(32'h10000000, x);
            udm.rd32(32'h20000000);
        end
    end

    $fclose(fd);
    $display("### VECTOR SIMULATION FINISHED ###");
    $stop;
    end
